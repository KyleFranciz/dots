{
  "workbench.iconTheme": "gruvbox-material-icon-theme",
  "liveServer.settings.donotShowInfoMsg": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "notebook.output.scrolling": true,
  "jupyter.interactiveWindow.creationMode": "perFile",

  "apc.electron": {
    "opacity": 0.5,
    "transparent": true,
    "backgroundColor": "#00000000",
    "vibrancy": "ultra-dark"
  },
  "animations.Enabled": true,
  "animations.Scrolling": "Slide",
  "animations.CursorAnimationOptions": {
    "CursorStyle": "line",
    "TrailLength": 12
  },
  "vscode_custom_css.imports": [
    "file:///Users/blase/.vscode/extensions/brandonkirbyson.vscode-animations-2.0.4/dist/updateHandler.js"
  ],
  "background.fullscreen": {
    "images": [
      "https://motionbgs.com/media/4423/miyamoto-musashi-vagabond.jpg"
    ],
    "opacity": 0.1,
    "size": "cover",
    "position": "center",
    "interval": 0,
    "random": false
  },
  "background.sidebar": {},
  "background.panel": {},
  "background.enabled": false,
  "editor.fontFamily": "Menlo, Monaco, 'Courier New', monospace",
  "editor.lineNumbers": "on",
  "editor.lineHeight": 2.5,

  "editor.fontLigatures": true,
  "editor.cursorBlinking": "phase",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorStyle": "line",
  "frosted-glass-theme.fakeMica.enabled": true,
  "workbench.colorCustomizations": {
    "terminal.background": "#00000000"
  },
  "workbench.settings.applyToAllProfiles": ["workbench.colorCustomizations"],
  "vscode_vibrancy.opacity": -0.3,
  "codium.enable": false,
  "editor.accessibilitySupport": "off",
  "githubPullRequests.createOnPublishBranch": "never",
  "codium.codeCompletion.userInstructions": "I am a student and I want to get better at remembering syntax and writing alot of the code myself, I only need help with the things that I already know or have done before\n",
  "editor.fontSize": 15,
  "workbench.sideBar.location": "right",
  "animations.Active": "Indent",
  "animations.Command-Palette": "Fade",
  "animations.CursorAnimation": true,
  "animations.Auto-Install": false,
  "animations.Install-Method": "Custom UI Style",
  "mcpServers": {
    "linear": {
      "command": "npx",
      "env": {},
      "args": ["-y", "mcp-remote", "https://mcp.linear.app/sse"]
    },
    "Framelink Figma MCP": {
      "command": "npx",
      "env": {},
      "args": [
        "-y",
        "figma-developer-mcp",
        "--figma-api-key=REDACTED",
        "--stdio"
      ]
    },
    "notion": {
      "command": "npx",
      "env": {
        "NOTION_API_TOKEN": "REDACTED"
      },
      "args": ["-y", "@suekou/mcp-notion-server"]
    }
  },
  "editor.scrollbar.verticalScrollbarSize": 12,
  "window.titleBarStyle": "custom",
  "workbench.editor.autoLockGroups": {
    "terminalEditor": false
  },
  "chat.commandCenter.enabled": false,
  "codium.codeCompletion.enable": true,
  "database-client.autoSync": true,
  "tabnine.experimentalAutoImports": true,
  "workbench.colorTheme": "City Lights",
  "codium.customInstructions.allMessages": "You are a senior software engineer, think of my like a new junior level engineer that doesn't know alot of concepts yet. I want you to coach in every instance and explain conecpts in a simple easy to understand way.",
  "codium.customInstructions.specificCommands": {},
  "codium.editorButton": true,
  "codium.rag.maxLocalSnippets": 5,
  "codium.rag.maxRemoteSnippets": 5,
  "codium.terminalAllowedCommands": [],
  "codium.terminalBlockedCommands": [],
  "[dockercompose]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.autoIndent": "advanced",
    "editor.quickSuggestions": {
      "other": true,
      "comments": false,
      "strings": true
    },
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "chat.useAgentSkills": true
}
