
# set up for the font style 
# font-family = "JetBrainsMono Nerd Font"
# font-family = FiraCode Nerd font-family
# font-family = caskaydiaMono Nerd Font
# font-family = DankMono Nerd Font Mono 
# font-family = "Code New Roman"
font-family = "Iosevka SS02"
font-size = 16
adjust-cell-height = 55%

# Font variations
# font-style = italic
# font-variation = ital=1
# ligatures and contextual alternates =>
font-feature = +liga  # Enable ligatures
font-feature = +calt  # Enable contextual alternates
font-feature = feat on

# Set up quake-style dropdown with Ctrl + /
keybind = global:ctrl+slash=toggle_quick_terminal

# setting for resetting the config
keybind = cmd+s>r=reload_config

# Optional: animation speed (in seconds)
# quick-terminal-animation-duration = 0.1

# Window settings
title = "Neovim"
macos-titlebar-style = hidden
window-subtitle = working-directory
window-title-font-family = true
window-new-tab-position = current
window-save-state = always


# Window size (columns x rows)
window-width = 150
window-height = 45
window-padding-x = 20
window-padding-y = 20
window-padding-balance = true

# keybinds for the window 

# Setting for auto updating
auto-update = check

