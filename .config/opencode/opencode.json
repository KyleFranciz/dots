{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-openai-codex-auth@4.1.0"],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "YOUR_API_KEY"
      },
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": true
    }
  },
  "agent": {
    "code-reviewer": {
      "description": "Reviews code that is written and helps to explain best practices and advice",
      "mode": "subagent",
      "model": "openai/gpt-5.1-codex-medium",
      "prompt": "You are a senior level software engineer, review the code that the user inquires about and give advice on the best practices, potential issues that may arise, look an note the potential security issues to consider, potential solutions, also break down new concepts in an easy to understand way. Break down everything as if your talking to a student that is just beginning to learn.",
      "temperature": 0.1,
      "reasoningEffort": "high",
      "textVerbosity": "high",
      "permission": {
        "edit": "deny",
        "webfetch": "allow"
      },
      "tools": {
        "write": false,
        "edit": false
      }
    },
    "Teacher Bot": {
      "description": "Teach the user best practices, advice on how to better sttructure code, and breaking down and learning new concepts.",
      "mode": "primary",
      "model": "openai/gpt-5.2-codex",
      "prompt": "You are a senior level software engineer, you are teaching a student that is new to software engineering principles and needs simple examples and analogies in order to understand concepts and ways to go about implementing things in a very simple way. Try to give ideas and steer the student along the path of the right idea on how to solve problems before giving the solution and explanations unless the user asks for it. Use other subagents if needed to make crafting responeses or gathering the needed information easily.",
      "temperature": 0.2,
      "reasoningEffort": "medium",
      "permission": {
        "edit": "deny",
        "webfetch": "allow",
        "bash": {
          "git-status": "allow",
          "git-commit": "deny"
        }
      },
      "tools": {
        "write": false,
        "edit": false
      }
    },

    "git-bot": {
      "description": "Makes commits to git noting the important changes that user implements",
      "mode": "subagent",
      "model": "openai/gpt-5.2-codex",
      "prompt": "You are an software engineering assistant that helps with making git commits, you analize the git history and diffs alongside anything you need to use to find and analize the changes that have been made. Make the commit message a title that sumarizes the changes, as well as list the key changes that are important to know, make sure that everything is sttructured in an easily readable way, list what parts were changed or editted and important notes sumarizing the changes in the commit for any person reading it.",
      "temperature": 0.1,
      "permission": {
        "edit": "deny",
        "bash": {
          "git commit": "ask",
          "git push": "ask",
          "git checkout": "ask",
          "*": "allow"
        },
        "webfetch": "deny"
      },
      "tools": {
        "write": true,
        "edit": false
      }
    }
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local models)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen2.5-coder:7b": {
          "name": "Qwen 2.5 Coder",
          "reasoning": true,
          "tool_call": true
        },
        "deepseek-r1:8b": {
          "name": "Deepseek-r1",
          "reasoning": true,
          "tool_call": true
        },
        "qwen3:8b": {
          "name": "Qwen3",
          "reasoning": true,
          "tool_call": true
        }
      }
    },
    "openai": {
      "options": {
        "reasoningEffort": "medium",
        "reasoningSummary": "auto",
        "textVerbosity": "medium",
        "include": ["reasoning.encrypted_content"],
        "store": false
      },
      "models": {
        "gpt-5.2-low": {
          "name": "GPT 5.2 Low (OAuth)",
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "options": {
            "reasoningEffort": "low",
            "reasoningSummary": "auto",
            "textVerbosity": "medium",
            "include": ["reasoning.encrypted_content"],
            "store": false
